#!/usr/bin/env bash
set -euo pipefail

GIT_DIR="$(git rev-parse --git-dir)"
STAMP_FILE="${GIT_DIR}/ci-local-pass"

if [ ! -f "${STAMP_FILE}" ]; then
  echo "❌ [BLOCK PRE-PUSH] Khong tim thay con dau ${STAMP_FILE}!"
  echo "👉 Vui long chay './backend/scripts/ci-local.sh' (hoac npm run ci:local trong backend) de kiem tra toan bo cong local truoc khi push."
  exit 1
fi

STAMP_SHA="$(awk '{print $1}' "${STAMP_FILE}" 2>/dev/null || echo "")"
HEAD_SHA="$(git rev-parse HEAD)"

if [ -z "${STAMP_SHA}" ] || [ "${STAMP_SHA}" != "${HEAD_SHA}" ]; then
  echo "❌ [BLOCK PRE-PUSH] Con dau ci-local-pass khong khop voi HEAD commit!"
  echo "   STAMP_SHA: ${STAMP_SHA}"
  echo "   HEAD_SHA:  ${HEAD_SHA}"
  echo "👉 Vui long chay './backend/scripts/ci-local.sh' (hoac npm run ci:local trong backend) de kiem tra va dong dau commit hien tai truoc khi push."
  exit 1
fi

echo "✅ [PRE-PUSH] Con dau ci-local-pass hop le (${HEAD_SHA}). Cho phep push."
exit 0

